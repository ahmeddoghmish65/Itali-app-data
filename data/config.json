  "faq": {
    "title": "الأسئلة الشائعة",
    "title_it": "Domande Frequenti",
    "categories": [
      {
        "id": "general",
        "name": "أسئلة عامة",
        "questions": [
          {
            "q": "هل التطبيق مجاني؟",
            "a": "نعم، تطبيق سهل إيطالي مجاني بالكامل مع جميع المستويات من A1 إلى B2."
          },
          {
            "q": "هل يعمل التطبيق بدون إنترنت؟",
            "a": "نعم، يمكنك تحميل الدروس والوصول إليها بدون اتصال بالإنترنت."
          },
          {
            "q": "ما المستويات المتاحة؟",
            "a": "نقدم حالياً المستويات A1, A2, B1, B2. المستويات C1 و C2 قريباً."
          }
        ]
      },
      {
        "id": "account",
        "name": "الحساب والبيانات",
        "questions": [
          {
            "q": "هل التسجيل إلزامي؟",
            "a": "لا، يمكنك استخدام التطبيق كضيف، لكن التسجيل يتيح حفظ تقدمك."
          },
          {
            "q": "كيف أحذف حسابي؟",
            "a": "من الإعدادات > الحساب > حذف الحساب، أو تواصل معنا عبر البريد."
          }
        ]
      },
      {
        "id": "technical",
        "name": "مشاكل تقنية",
        "questions": [
          {
            "q": "التطبيق لا يعمل، ماذا أفعل؟",
            "a": "جرب إعادة تشغيل التطبيق أو تحديثه. إذا استمرت المشكلة، تواصل معنا."
          },
          {
            "q": "الصوت لا يعمل",
            "a": "تأكد من رفع صوت الجهاز وعدم تفعيل وضع الصامت."
          }
        ]
      }
    ]
