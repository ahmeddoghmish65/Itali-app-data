    {
        "id": "cafe",
        "title": "في المقهى",
        "icon": "coffee",
        "dialogue": [
            { "speaker": "A", "name": "الزبون", "it": "Buongiorno! Un caffè, per favore.", "ar": "صباح الخير! قهوة، من فضلك." },
            { "speaker": "B", "name": "النادل", "it": "Buongiorno! Normale o macchiato?", "ar": "صباح الخير! عادية أم بالحليب؟" },
            { "speaker": "A", "name": "الزبون", "it": "Macchiato, grazie.", "ar": "بالحليب، شكراً." },
            { "speaker": "B", "name": "النادل", "it": "Ecco a Lei. Sono due euro.", "ar": "تفضل. يورو اثنين." },
            { "speaker": "A", "name": "الزبون", "it": "Ecco. Grazie mille!", "ar": "تفضل. شكراً جزيلاً!" },
            { "speaker": "B", "name": "النادل", "it": "Prego! Buona giornata!", "ar": "عفواً! يوماً سعيداً!" }
        ]
    },
    {
        "id": "restaurant",
        "title": "في المطعم",
        "icon": "utensils",
        "dialogue": [
            { "speaker": "A", "name": "النادل", "it": "Buonasera! Avete prenotato?", "ar": "مساء الخير! هل حجزتم؟" },
            { "speaker": "B", "name": "الزبون", "it": "Sì, un tavolo per due, per favore.", "ar": "نعم، طاولة لشخصين من فضلك." },
            { "speaker": "A", "name": "النادل", "it": "Prego, ecco il menu.", "ar": "تفضلوا، ها هي القائمة." },
            { "speaker": "B", "name": "الزبون", "it": "Vorrei una pizza Margherita e acqua.", "ar": "أود بيتزا مارغريتا وماء." },
            { "speaker": "A", "name": "النادل", "it": "Benissimo. Altro?", "ar": "ممتاز. شيء آخر؟" },
            { "speaker": "B", "name": "الزبون", "it": "No, grazie. Il conto, per favore.", "ar": "لا، شكراً. الحساب من فضلك." }
        ]
    },
    {
        "id": "directions",
        "title": "السؤال عن الاتجاهات",
        "icon": "map-pin",
        "dialogue": [
            { "speaker": "A", "name": "السائح", "it": "Scusi, dov'è la stazione?", "ar": "عذراً، أين المحطة؟" },
            { "speaker": "B", "name": "المارة", "it": "È sempre dritto, poi a destra.", "ar": "إنه إلى الأمام مباشرة، ثم يميناً." },
            { "speaker": "A", "name": "السائح", "it": "È lontano da qui?", "ar": "هل هو بعيد من هنا؟" },
            { "speaker": "B", "name": "المارة", "it": "No, è vicino. Cinque minuti a piedi.", "ar": "لا، إنه قريب. خمس دقائق مشياً." },
            { "speaker": "A", "name": "السائح", "it": "Grazie mille!", "ar": "شكراً جزيلاً!" },
            { "speaker": "B", "name": "المارة", "it": "Di niente. Arrivederci!", "ar": "على الرحب والسعة. إلى اللقاء!" }
        ]
    },
    {
