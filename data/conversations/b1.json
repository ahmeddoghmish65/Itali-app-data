            { "speaker": "A", "name": "الضيف", "it": "Esatto. A che ora è la colazione?", "ar": "بالضبط. في أي ساعة الإفطار؟" },
            { "speaker": "B", "name": "الاستقبال", "it": "Dalle sette alle dieci.", "ar": "من السابعة حتى العاشرة." }
        ]
    },
    {
