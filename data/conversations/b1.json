        "dialogue": [
            { "speaker": "A", "name": "الإيطالي", "it": "Vai sempre dritto e poi gira.", "ar": "إذهب دائمًا للأمام ثم انعطف." },
            { "speaker": "B", "name": "الطالب", "it": "Scusi, non capisco. Può ripetere?", "ar": "عذراً، لا أفهم. هل يمكنك الإعادة؟" },
            { "speaker": "A", "name": "الإيطالي", "it": "Parlo più piano. Dritto... poi destra.", "ar": "سأتحدث ببطء أكثر. للأمام... ثم يمين." },
            { "speaker": "B", "name": "الطالب", "it": "Parla inglese?", "ar": "هل تتحدث الإنجليزية؟" },
            { "speaker": "A", "name": "الإيطالي", "it": "Solo un po'.", "ar": "قليلاً فقط." },
            { "speaker": "B", "name": "الطالب", "it": "Va bene, grazie mille. Ho capito.", "ar": "حسناً، شكراً جزيلاً. لقد فهمت." }
        ]
    },
