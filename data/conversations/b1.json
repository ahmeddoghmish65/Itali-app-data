        "icon": "plus-circle",
        "dialogue": [
            { "speaker": "A", "name": "المريض", "it": "Buongiorno. Ho mal di testa.", "ar": "صباح الخير. لدي صداع." },
            { "speaker": "B", "name": "الصيدلي", "it": "Ha la febbre?", "ar": "هل لديك حرارة (حمى)؟" },
            { "speaker": "A", "name": "المريض", "it": "No, solo mal di testa.", "ar": "لا، فقط صداع." },
            { "speaker": "B", "name": "الصيدلي", "it": "Prenda questa medicina dopo mangiato.", "ar": "خذ هذا الدواء بعد الأكل." },
            { "speaker": "A", "name": "المريض", "it": "Grazie. Quante volte al giorno?", "ar": "شكراً. كم مرة في اليوم؟" },
            { "speaker": "B", "name": "الصيدلي", "it": "Due volte. Mattina e sera.", "ar": "مرتين. صباحاً ومساءً." }
        ]
    },
    {
