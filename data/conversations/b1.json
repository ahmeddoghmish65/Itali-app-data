        "icon": "shopping-cart",
        "dialogue": [
            { "speaker": "A", "name": "البائع", "it": "Buongiorno! Dimmi.", "ar": "صباح الخير! أخبرني (ماذا تريد)." },
            { "speaker": "B", "name": "المشتري", "it": "Vorrei un chilo di mele.", "ar": "أريد كيلو من التفاح." },
            { "speaker": "A", "name": "البائع", "it": "Ecco. Altro?", "ar": "تفضل. شيء آخر؟" },
            { "speaker": "B", "name": "المشتري", "it": "Quanto costa questo formaggio?", "ar": "بكم هذه الجبنة؟" },
            { "speaker": "A", "name": "البائع", "it": "Cinque euro.", "ar": "خمسة يورو." },
            { "speaker": "B", "name": "المشتري", "it": "Va bene, prendo anche questo.", "ar": "حسناً، سآخذ هذا أيضاً." }
        ]
    },
    {
        "id": "transport",
        "title": "تذكرة القطار",
        "icon": "train",
        "dialogue": [
            { "speaker": "A", "name": "المسافر", "it": "Un biglietto per Roma, per favore.", "ar": "تذكرة إلى روما، من فضلك." },
            { "speaker": "B", "name": "الموظف", "it": "Solo andata o andata e ritorno?", "ar": "ذهاب فقط أم ذهاب وعودة؟" },
            { "speaker": "A", "name": "المسافر", "it": "Solo andata. Quanto è?", "ar": "ذهاب فقط. كم السعر؟" },
            { "speaker": "B", "name": "الموظف", "it": "Venti euro. Il treno parte alle dieci.", "ar": "عشرون يورو. القطار يغادر في العاشرة." },
            { "speaker": "A", "name": "المسافر", "it": "Da quale binario?", "ar": "من أي رصيف؟" },
            { "speaker": "B", "name": "الموظف", "it": "Binario tre.", "ar": "الرصيف ثلاثة." }
        ]
    },
    {
